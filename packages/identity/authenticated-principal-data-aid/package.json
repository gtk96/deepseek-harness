      "default": "./lib/direct-query-tools.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/loopback-test.js",
    "lib/mse-gateway.js",
    "lib/turn-principal.js",
    "lib/data-query-tool.js",
