# Required for the built-in deepseek-official LLM route.
# Supply the real value through the deployment secret store, never this file.
DEEPSEEK_API_KEY=

# Optional: use only when this deployment routes DeepSeek requests through an
# approved compatible gateway. Omit it to call the official API endpoint.
DEEPSEEK_BASE_URL=

# Service-authenticated DIC-BE -> DSH turn ingress. Keep the token in the
# deployment secret store and restrict this listener to the trusted service network.
DATA_AID_INGRESS_HOST=127.0.0.1
DATA_AID_INGRESS_PORT=3081
DATA_AID_INGRESS_PATH=/v1/internal/data-query/turns
DATA_AID_INGRESS_SERVICE_IDENTITY=dic-be

# Kubernetes probes on the dedicated internal listener.
DATA_AID_HEALTH_LIVE_PATH=/healthz/live
DATA_AID_HEALTH_READY_PATH=/healthz/ready

DATA_AID_INGRESS_SERVICE_TOKEN=
DATA_AID_INGRESS_MAX_BODY_BYTES=16384
DATA_AID_INGRESS_MAX_QUESTION_CHARS=4096


# Model-hidden DSH -> DIC-BE broker lifecycle callback. Use a distinct secret
# from the ingress token and keep the URL on the trusted service network.
DATA_AID_TURN_CALLBACK_URL=
DATA_AID_TURN_CALLBACK_SERVICE_IDENTITY=dsh
DATA_AID_TURN_CALLBACK_SERVICE_TOKEN=
DATA_AID_TURN_CALLBACK_TIMEOUT_SECONDS=10
DATA_AID_TURN_CALLBACK_MAX_ATTEMPTS=3
DATA_AID_TURN_CALLBACK_RETRY_DELAY_MS=250
DATA_AID_TURN_CALLBACK_MAX_BODY_BYTES=1100000
DATA_AID_TURN_CALLBACK_MAX_ANSWER_CHARS=16384
DATA_AID_INGRESS_MAX_TRACKED_TURNS=100000

# Controlled Data Query broker. Keep the JSON key ring and active key id in the
# deployment secret store; this file intentionally contains no key material.
DATA_AID_QUERY_BASE_URL=
DATA_AID_QUERY_PATH=/v1/internal/data-query/query
DATA_AID_QUERY_ISSUER=
DATA_AID_QUERY_AUDIENCE=
DATA_AID_QUERY_ASSERTION_KEY_RING=
DATA_AID_QUERY_ASSERTION_ACTIVE_KID=
DATA_AID_QUERY_ASSERTION_TTL_SECONDS=30
DATA_AID_QUERY_TIMEOUT_SECONDS=30
DATA_AID_QUERY_MAX_ROWS=100
DATA_AID_QUERY_MAX_RESULT_BYTES=1048576
DATA_AID_QUERY_DEFAULT_LIMIT=100
DATA_AID_QUERY_MAX_SELECTED_FIELDS=32
DATA_AID_QUERY_MAX_FILTERS=32
DATA_AID_QUERY_MAX_ORDER_BY=32
DATA_AID_QUERY_MAX_IN_VALUES=32
DATA_AID_QUERY_MAX_VALUE_CHARS=256
